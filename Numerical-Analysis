    // --- Master Simulation Canvas Drawing Routine ---
    function drawSimulation() {
      const W = simCanvas.width;
      const H = simCanvas.height;
      ctx.clearRect(0, 0, W, H);

      // Background
      ctx.fillStyle = "#0f172a"; // Slate 900
      ctx.fillRect(0, 0, W, H);

      if (currentUnit === 1) {
        drawUnit1Sim(W, H);
      } else if (currentUnit === 2) {
        drawUnit2Sim(W, H);
      } else if (currentUnit === 3) {
        drawUnit3Sim(W, H);
      } else if (currentUnit === 4) {
        drawUnit4Sim(W, H);
      } else if (currentUnit === 5) {
        drawUnit5Sim(W, H);
      } else if (currentUnit === 6) {
        drawUnit6Sim(W, H);
      } else if (currentUnit === 7) {
        drawUnit7Sim(W, H);
      } else if (currentUnit === 8) {
        drawUnit8Sim(W, H);
      }
    }

    // --- Simulation 1: Heine-Borel & Shrinking Intervals ---
    function drawUnit1Sim(W, H) {
      const margin = 50;
      const lineY = H * 0.65;
      const x0 = margin;
      const x1 = W - margin;
      const len = x1 - x0;

      // Draw real axis
      ctx.strokeStyle = "#475569";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(20, lineY);
      ctx.lineTo(W - 20, lineY);
      ctx.stroke();

      if (simState.u1_mode === 'heine') {
        // [a, b] segment
        ctx.strokeStyle = "#38bdf8";
        ctx.lineWidth = 6;
        ctx.beginPath();
        ctx.moveTo(x0, lineY);
        ctx.lineTo(x1, lineY);
        ctx.stroke();

        // Endpoints a and b
        ctx.fillStyle = "#38bdf8";
        ctx.beginPath(); ctx.arc(x0, lineY, 6, 0, Math.PI*2); ctx.fill();
        ctx.beginPath(); ctx.arc(x1, lineY, 6, 0, Math.PI*2); ctx.fill();

        ctx.fillStyle = "#94a3b8";
        ctx.font = "12px sans-serif";
        ctx.fillText("a = 0", x0 - 15, lineY + 25);
        ctx.fillText("b = 1", x1 - 15, lineY + 25);

        // Draw open cover intervals
        const n = simState.u1_n;
        const radius = len / (n - 0.5);
        const colors = ["#a855f7", "#ec4899", "#10b981", "#f59e0b", "#6366f1", "#14b8a6", "#f43f5e", "#84cc16", "#06b6d4", "#eab308"];

        for (let i = 0; i < n; i++) {
          const center = x0 + (i / (n - 1)) * len;
          const left = center - radius * 0.6;
          const right = center + radius * 0.6;
          const arcY = lineY - 30 - (i % 3) * 22;

          ctx.strokeStyle = colors[i % colors.length];
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.moveTo(Math.max(20, left), arcY);
          ctx.lineTo(Math.min(W - 20, right), arcY);
          ctx.stroke();

          // End ticks
          ctx.beginPath();
          ctx.arc(Math.max(20, left), arcY, 3, 0, Math.PI*2);
          ctx.arc(Math.min(W - 20, right), arcY, 3, 0, Math.PI*2);
          ctx.stroke();

          // Projection lines to axis
          ctx.strokeStyle = colors[i % colors.length] + "44";
          ctx.setLineDash([3, 3]);
          ctx.beginPath();
          ctx.moveTo(center, arcY);
          ctx.lineTo(center, lineY);
          ctx.stroke();
          ctx.setLineDash([]);
        }

        canvasOverlayStats.innerHTML = `Covering [0, 1] with ${n} open sets &bull; Finite Subcover extracted!`;
      } else {
        // Shrinking (-1/n, 1/n)
        const originX = W / 2;
        ctx.fillStyle = "#f59e0b";
        ctx.beginPath(); ctx.arc(originX, lineY, 6, 0, Math.PI*2); ctx.fill();
        ctx.font = "13px sans-serif";
        ctx.fillText("0", originX - 4, lineY + 22);

        const n = simState.u1_n;
        for (let k = 1; k <= n; k++) {
          const r = (len * 0.45) / k;
          const y = lineY - 20 - (k - 1) * 20;

          ctx.strokeStyle = k === n ? "#10b981" : "#64748b";
          ctx.lineWidth = k === n ? 3 : 1.5;
          ctx.beginPath();
          ctx.moveTo(originX - r, y);
          ctx.lineTo(originX + r, y);
          ctx.stroke();

          ctx.fillStyle = k === n ? "#10b981" : "#94a3b8";
          ctx.fillText(`(-1/${k}, 1/${k})`, originX + r + 8, y + 4);
        }

        canvasOverlayStats.innerHTML = `At step n = ${n}: Width = 2/${n} &bull; As n &rarr; &infin;, &Intersection; (-1/n, 1/n) = {0}`;
      }
    }

    // --- Simulation 2: Cantor Set ---
    function drawUnit2Sim(W, H) {
      const level = simState.u2_level;
      const startY = 35;
      const rowHeight = Math.min(36, (H - 70) / (level + 1));
      const margin = 40;
      const totalWidth = W - 2 * margin;

      ctx.font = "11px monospace";

      for (let curL = 0; curL <= level; curL++) {
        const y = startY + curL * rowHeight;
        const numSegments = Math.pow(2, curL);
        const segLen = totalWidth / Math.pow(3, curL);

        ctx.fillStyle = "#94a3b8";
        ctx.fillText(`L${curL}`, 10, y + 6);

        ctx.fillStyle = curL === level ? "#34d399" : "#60a5fa";

        // Recursive intervals
        function drawCantorInterval(x, w, step) {
          if (step === 0) {
            ctx.fillRect(x, y, w, 8);
            return;
          }
          const subW = w / 3;
          drawCantorInterval(x, subW, step - 1);
          drawCantorInterval(x + 2 * subW, subW, step - 1);
        }

        drawCantorInterval(margin, totalWidth, curL);
      }

      const remMeasure = Math.pow(2/3, level);
      canvasOverlayStats.innerHTML = `Step ${level}: Remaining Intervals = ${Math.pow(2, level)} &bull; Length = (2/3)^${level} = ${remMeasure.toFixed(4)}`;
    }

    // --- Simulation 3: Simple Function Approximation ---
    function drawUnit3Sim(W, H) {
      const margin = 45;
      const plotW = W - 2 * margin;
      const plotH = H - 2 * margin;
      const ox = margin;
      const oy = H - margin;

      // Axes
      ctx.strokeStyle = "#475569";
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(ox, oy); ctx.lineTo(ox + plotW, oy);
      ctx.moveTo(ox, oy); ctx.lineTo(ox, oy - plotH);
      ctx.stroke();

      ctx.fillStyle = "#94a3b8";
      ctx.font = "11px sans-serif";
      ctx.fillText("0", ox - 12, oy + 15);
      ctx.fillText("x", ox + plotW + 5, oy + 5);
      ctx.fillText("y", ox - 5, oy - plotH - 8);

      // Target curve f(x) = (x/1.2)^2 on [0, 1]
      function f(x) {
        return Math.sin(x * Math.PI * 0.85) * 0.8 + 0.15;
      }

      // Draw horizontal slices on Y-axis
      const numSlices = Math.pow(2, simState.u3_slices);
      const dy = 1.0 / numSlices;

      for (let k = 0; k < numSlices; k++) {
        const yVal = k * dy;
        const screenY = oy - yVal * plotH;
        ctx.strokeStyle = "#334155";
        ctx.setLineDash([2, 4]);
        ctx.beginPath();
        ctx.moveTo(ox, screenY);
        ctx.lineTo(ox + plotW, screenY);
        ctx.stroke();
      }
      ctx.setLineDash([]);

      // Draw simple function approximation phi_n(x)
      ctx.fillStyle = "rgba(99, 102, 241, 0.35)";
      ctx.strokeStyle = "#818cf8";
      ctx.lineWidth = 2;

      ctx.beginPath();
      for (let px = 0; px <= plotW; px += 2) {
        const normX = px / plotW;
        const fVal = f(normX);
        const stepVal = Math.floor(fVal / dy) * dy;
        const screenY = oy - stepVal * plotH;

        if (px === 0) {
          ctx.moveTo(ox + px, screenY);
        } else {
          ctx.lineTo(ox + px, screenY);
        }
      }
      ctx.stroke();

      // Original smooth curve f(x)
      ctx.strokeStyle = "#f59e0b";
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      for (let px = 0; px <= plotW; px += 2) {
        const normX = px / plotW;
        const fVal = f(normX);
        const screenY = oy - fVal * plotH;
        if (px === 0) ctx.moveTo(ox + px, screenY);
        else ctx.lineTo(ox + px, screenY);
      }
      ctx.stroke();

      canvasOverlayStats.innerHTML = `Range Slices: 2^${simState.u3_slices} = ${numSlices} &bull; Yellow = f(x), Violet = Simple &phi;_n(x) &le; f(x)`;
    }

    // --- Simulation 4: Riemann vs Lebesgue Showdown ---
    function drawUnit4Sim(W, H) {
      const margin = 45;
      const plotW = W - 2 * margin;
      const plotH = H - 2 * margin;
      const ox = margin;
      const oy = H - margin;

      // Axes
      ctx.strokeStyle = "#475569";
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(ox, oy); ctx.lineTo(ox + plotW, oy);
      ctx.moveTo(ox, oy); ctx.lineTo(ox, oy - plotH);
      ctx.stroke();

      ctx.fillStyle = "#94a3b8";
      ctx.font = "11px sans-serif";
      ctx.fillText("0", ox - 12, oy + 15);
      ctx.fillText("1", ox + plotW - 4, oy + 15);

      if (simState.u4_type === 'dirichlet') {
        // Dirichlet Function
        if (simState.u4_method === 'riemann') {
          // Riemann partition showing oscillating upper and lower rectangles
          const N = simState.u4_n;
          const dx = plotW / N;

          for (let i = 0; i < N; i++) {
            // Upper box (height 1)
            ctx.fillStyle = "rgba(239, 68, 68, 0.25)";
            ctx.strokeStyle = "#ef4444";
            ctx.lineWidth = 1;
            ctx.fillRect(ox + i * dx, oy - plotH * 0.7, dx, plotH * 0.7);
            ctx.strokeRect(ox + i * dx, oy - plotH * 0.7, dx, plotH * 0.7);

            // Lower line (height 0)
            ctx.strokeStyle = "#10b981";
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(ox + i * dx, oy);
            ctx.lineTo(ox + (i+1) * dx, oy);
            ctx.stroke();
          }

          ctx.fillStyle = "#f87171";
          ctx.fillText("Upper Sum U(f, P) = 1.00", ox + 20, oy - plotH * 0.8);
          ctx.fillStyle = "#34d399";
          ctx.fillText("Lower Sum L(f, P) = 0.00", ox + 20, oy - plotH * 0.8 + 18);
          canvasOverlayStats.innerHTML = `<span class="text-rose-400">U(f,P) &ne; L(f,P)</span> &bull; Riemann Integral DOES NOT EXIST!`;
        } else {
          // Lebesgue Range Partition for Dirichlet
          ctx.fillStyle = "rgba(16, 185, 129, 0.2)";
          ctx.fillRect(ox, oy - 2, plotW, 4);

          // Range values: 0 and 1
          ctx.fillStyle = "#38bdf8";
          ctx.beginPath(); ctx.arc(ox - 10, oy, 5, 0, Math.PI*2); ctx.fill();
          ctx.beginPath(); ctx.arc(ox - 10, oy - plotH * 0.7, 5, 0, Math.PI*2); ctx.fill();

          ctx.fillStyle = "#e2e8f0";
          ctx.fillText("Value 0 on [0,1] \ Q (m = 1)", ox + 15, oy - 15);
          ctx.fillText("Value 1 on Q (m = 0)", ox + 15, oy - plotH * 0.7 - 8);

          // Draw dotted points for rationals
          ctx.fillStyle = "#f59e0b";
          for (let k = 1; k < 60; k++) {
            const rx = ox + (k / 60) * plotW;
            ctx.fillRect(rx - 1, oy - plotH * 0.7 - 1, 3, 3);
          }

          canvasOverlayStats.innerHTML = `Lebesgue: &int; &chi;_Q = 1&middot;m(Q) + 0&middot;m(Q^c) = 1(0) + 0(1) = 0.00`;
        }
      } else {
        // Smooth function f(x)
        function f(x) { return Math.sin(x * Math.PI) * 0.7 + 0.15; }

        if (simState.u4_method === 'riemann') {
          // Vertical columns
          const N = simState.u4_n;
          const dx = plotW / N;
          ctx.fillStyle = "rgba(99, 102, 241, 0.25)";
          ctx.strokeStyle = "#818cf8";
          ctx.lineWidth = 1;

          for (let i = 0; i < N; i++) {
            const midX = (i + 0.5) / N;
            const h = f(midX) * plotH;
            ctx.fillRect(ox + i * dx, oy - h, dx, h);
            ctx.strokeRect(ox + i * dx, oy - h, dx, h);
          }
        } else {
          // Horizontal layers
          const N = simState.u4_n;
          const dy = 0.85 / N;

          for (let j = 0; j < N; j++) {
            const yMid = (j + 0.5) * dy;
            const screenY = oy - (j + 1) * dy * plotH;
            const stripH = dy * plotH;

            // pre-image width where f(x) >= yMid
            // For sin(pi*x) * 0.7 + 0.15 >= yMid
            const target = (yMid - 0.15) / 0.7;
            if (target <= 1 && target >= 0) {
              const asinVal = Math.asin(target) / Math.PI;
              const leftX = asinVal * plotW;
              const rightX = (1 - asinVal) * plotW;
              const width = Math.max(0, rightX - leftX);

              ctx.fillStyle = "rgba(16, 185, 129, 0.3)";
              ctx.strokeStyle = "#34d399";
              ctx.lineWidth = 1;
              ctx.fillRect(ox + leftX, screenY, width, stripH);
              ctx.strokeRect(ox + leftX, screenY, width, stripH);
            }
          }
        }

        // Draw curve
        ctx.strokeStyle = "#f59e0b";
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        for (let px = 0; px <= plotW; px += 2) {
          const sy = oy - f(px / plotW) * plotH;
          if (px === 0) ctx.moveTo(ox + px, sy);
          else ctx.lineTo(ox + px, sy);
        }
        ctx.stroke();

        canvasOverlayStats.innerHTML = `${simState.u4_method === 'riemann' ? 'Domain partitioning: Vertical rectangles' : 'Range partitioning: Horizontal pre-image slices'} &bull; N = ${simState.u4_n}`;
      }
    }

    // --- Simulation 5: General Lebesgue Integral & LDCT ---
    function drawUnit5Sim(W, H) {
      const margin = 45;
      const plotW = W - 2 * margin;
      const plotH = H - 2 * margin;
      const ox = margin;
      const midY = H / 2;

      // Axes
      ctx.strokeStyle = "#475569";
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(ox, midY); ctx.lineTo(ox + plotW, midY);
      ctx.moveTo(ox, margin); ctx.lineTo(ox, H - margin);
      ctx.stroke();

      if (simState.u5_wave_shift === 0) {
        // Positive & Negative Split f = f^+ - f^-
        function wave(x) { return Math.sin(x * Math.PI * 2) * (plotH * 0.4); }

        // Draw f^+ (green fill)
        ctx.fillStyle = "rgba(16, 185, 129, 0.3)";
        ctx.beginPath();
        ctx.moveTo(ox, midY);
        for (let px = 0; px <= plotW; px += 2) {
          const val = wave(px / plotW);
          const y = val > 0 ? midY - val : midY;
          ctx.lineTo(ox + px, y);
        }
        ctx.lineTo(ox + plotW, midY);
        ctx.fill();

        // Draw f^- (rose fill)
        ctx.fillStyle = "rgba(244, 63, 94, 0.3)";
        ctx.beginPath();
        ctx.moveTo(ox, midY);
        for (let px = 0; px <= plotW; px += 2) {
          const val = wave(px / plotW);
          const y = val < 0 ? midY - val : midY;
          ctx.lineTo(ox + px, y);
        }
        ctx.lineTo(ox + plotW, midY);
        ctx.fill();

        // Outline original f
        ctx.strokeStyle = "#38bdf8";
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        for (let px = 0; px <= plotW; px += 2) {
          const y = midY - wave(px / plotW);
          if (px === 0) ctx.moveTo(ox + px, y);
          else ctx.lineTo(ox + px, y);
        }
        ctx.stroke();

        ctx.fillStyle = "#34d399";
        ctx.fillText("f+(x) = max(f, 0)", ox + 30, midY - 45);
        ctx.fillStyle = "#fb7185";
        ctx.fillText("f-(x) = max(-f, 0)", ox + plotW * 0.6, midY + 55);

        canvasOverlayStats.innerHTML = `f = f^+ - f^- &bull; |f| = f^+ + f^- &bull; Integrable iff &int; |f| < &infin;`;
      } else {
        // LDCT Envelope g(x)
        const envelope = (x) => (plotH * 0.42) / (1 + 2 * x);

        // Draw envelope g(x) and -g(x)
        ctx.strokeStyle = "#f59e0b";
        ctx.setLineDash([4, 4]);
        ctx.lineWidth = 2;
        ctx.beginPath();
        for (let px = 0; px <= plotW; px += 2) {
          const env = envelope(px / plotW);
          if (px === 0) ctx.moveTo(ox + px, midY - env);
          else ctx.lineTo(ox + px, midY - env);
        }
        ctx.stroke();

        ctx.beginPath();
        for (let px = 0; px <= plotW; px += 2) {
          const env = envelope(px / plotW);
          if (px === 0) ctx.moveTo(ox + px, midY + env);
          else ctx.lineTo(ox + px, midY + env);
        }
        ctx.stroke();
        ctx.setLineDash([]);

        // Draw trapped f_n(x)
        ctx.strokeStyle = "#60a5fa";
        ctx.lineWidth = 2;
        ctx.beginPath();
        for (let px = 0; px <= plotW; px += 2) {
          const normX = px / plotW;
          const env = envelope(normX);
          const fnVal = Math.sin(normX * 18) * (env * 0.7);
          if (px === 0) ctx.moveTo(ox + px, midY - fnVal);
          else ctx.lineTo(ox + px, midY - fnVal);
        }
        ctx.stroke();

        ctx.fillStyle = "#f59e0b";
        ctx.fillText("+g(x) [Dominating Envelope]", ox + plotW * 0.5, midY - 60);
        ctx.fillText("-g(x)", ox + plotW * 0.5, midY + 65);
        ctx.fillStyle = "#60a5fa";
        ctx.fillText("f_n(x) trapped inside", ox + 20, midY - 15);

        canvasOverlayStats.innerHTML = `|f_n(x)| &le; g(x) &bull; Dominance enforces lim &int; f_n = &int; lim f_n`;
      }
    }

    // --- Simulation 6: Total Variation & BV ---
    function drawUnit6Sim(W, H) {
      const margin = 45;
      const plotW = W - 2 * margin;
      const plotH = H - 2 * margin;
      const ox = margin;
      const oy = H - margin;

      // Axes
      ctx.strokeStyle = "#475569";
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(ox, oy); ctx.lineTo(ox + plotW, oy);
      ctx.moveTo(ox, oy); ctx.lineTo(ox, oy - plotH);
      ctx.stroke();

      const N = simState.u6_parts;
      let func = null;

      if (simState.u6_func === 'zigzag') {
        func = (x) => Math.sin(x * 6) * 0.35 + 0.45;
      } else {
        // x cos(pi / (2x))
        func = (x) => {
          if (x <= 0.005) return 0;
          return (x * Math.cos(Math.PI / (2 * x))) * 0.45 + 0.45;
        };
      }

      // Draw partition points and step variation
      let totalV = 0;
      const pts = [];
      for (let i = 0; i <= N; i++) {
        const x = i / N;
        const y = func(x);
        pts.push({ x: ox + x * plotW, y: oy - y * plotH, val: y });
        if (i > 0) {
          totalV += Math.abs(pts[i].val - pts[i-1].val);
        }
      }

      // Draw variation chords (lines between partition points)
      ctx.strokeStyle = "#ec4899";
      ctx.lineWidth = 2;
      ctx.beginPath();
      pts.forEach((p, idx) => {
        if (idx === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      });
      ctx.stroke();

      // Draw points
      ctx.fillStyle = "#f43f5e";
      pts.forEach(p => {
        ctx.beginPath(); ctx.arc(p.x, p.y, 4, 0, Math.PI*2); ctx.fill();
      });

      // Draw actual function underneath
      ctx.strokeStyle = "#38bdf8";
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      for (let px = 0; px <= plotW; px += 2) {
        const x = px / plotW;
        const sy = oy - func(x) * plotH;
        if (px === 0) ctx.moveTo(ox + px, sy);
        else ctx.lineTo(ox + px, sy);
      }
      ctx.stroke();

      canvasOverlayStats.innerHTML = `Partition N = ${N} &bull; Variation V(f, P) = ${totalV.toFixed(3)} ${simState.u6_func === 'nonbv' ? '(Diverges to &infin;!)' : '(Bounded)'}`;
    }

    // --- Simulation 7: The Devil's Staircase ---
    function drawUnit7Sim(W, H) {
      const margin = 45;
      const plotW = W - 2 * margin;
      const plotH = H - 2 * margin;
      const ox = margin;
      const oy = H - margin;

      // Axes
      ctx.strokeStyle = "#475569";
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(ox, oy); ctx.lineTo(ox + plotW, oy);
      ctx.moveTo(ox, oy); ctx.lineTo(ox, oy - plotH);
      ctx.stroke();

      ctx.fillStyle = "#94a3b8";
      ctx.font = "11px sans-serif";
      ctx.fillText("(0,0)", ox - 20, oy + 15);
      ctx.fillText("(1,1)", ox + plotW - 5, oy - plotH - 5);

      const maxDepth = simState.u7_cantor_step;

      function getCantorVal(x, depth) {
        let yLow = 0, yHigh = 1;
        let xLow = 0, xHigh = 1;
        for (let d = 0; d < depth; d++) {
          const l1 = xLow + (xHigh - xLow) / 3;
          const r1 = xLow + 2 * (xHigh - xLow) / 3;
          const yMid = (yLow + yHigh) / 2;

          if (x >= l1 && x <= r1) {
            return yMid;
          } else if (x < l1) {
            xHigh = l1;
            yHigh = yMid;
          } else {
            xLow = r1;
            yLow = yMid;
          }
        }
        return (yLow + yHigh) / 2;
      }

      ctx.strokeStyle = "#34d399";
      ctx.lineWidth = 3;
      ctx.beginPath();
      for (let px = 0; px <= plotW; px += 2) {
        const x = px / plotW;
        const y = getCantorVal(x, maxDepth);
        const sy = oy - y * plotH;
        if (px === 0) ctx.moveTo(ox + px, sy);
        else ctx.lineTo(ox + px, sy);
      }
      ctx.stroke();

      // Highlight horizontal plateaus where F'(x) = 0
      ctx.fillStyle = "rgba(245, 158, 11, 0.25)";
      const l1 = ox + plotW / 3;
      const r1 = ox + 2 * plotW / 3;
      ctx.fillRect(l1, oy - plotH / 2 - 4, r1 - l1, 8);

      ctx.fillStyle = "#f59e0b";
      ctx.font = "11px sans-serif";
      ctx.fillText("F'(x) = 0 on middle-third (y=1/2)", l1 + 10, oy - plotH / 2 - 10);

      canvasOverlayStats.innerHTML = `Cantor Function (Depth ${maxDepth}): F(1) - F(0) = 1, but &int; F' = 0 &bull; NOT Absolutely Continuous!`;
    }

    // --- Simulation 8: L^p Unit Balls & Young's Inequality ---
    function drawUnit8Sim(W, H) {
      const p = simState.u8_p;
      const cx = W / 2;
      const cy = H / 2;
      const R = Math.min(W, H) * 0.38;

      // Axes
      ctx.strokeStyle = "#334155";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(cx - R * 1.3, cy); ctx.lineTo(cx + R * 1.3, cy);
      ctx.moveTo(cx, cy - R * 1.3); ctx.lineTo(cx, cy + R * 1.3);
      ctx.stroke();

      ctx.fillStyle = "#94a3b8";
      ctx.font = "11px sans-serif";
      ctx.fillText("1", cx + R - 3, cy + 15);
      ctx.fillText("-1", cx - R - 10, cy + 15);
      ctx.fillText("1", cx + 8, cy - R + 5);
      ctx.fillText("-1", cx + 8, cy + R + 5);

      // Draw L^p unit ball: |x|^p + |y|^p = 1
      ctx.fillStyle = p < 1 ? "rgba(239, 68, 68, 0.25)" : "rgba(99, 102, 241, 0.25)";
      ctx.strokeStyle = p < 1 ? "#ef4444" : "#818cf8";
      ctx.lineWidth = 2.5;

      ctx.beginPath();
      const steps = 360;
      for (let i = 0; i <= steps; i++) {
        const theta = (i / steps) * Math.PI * 2;
        const cosT = Math.cos(theta);
        const sinT = Math.sin(theta);

        // |r cos|^p + |r sin|^p = 1 => r = 1 / (|cos|^p + |sin|^p)^(1/p)
        const denom = Math.pow(Math.pow(Math.abs(cosT), p) + Math.pow(Math.abs(sinT), p), 1 / p);
        const r = R / denom;

        const px = cx + r * cosT;
        const py = cy - r * sinT;

        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      const q = p <= 1.05 ? Infinity : p / (p - 1);
      const qStr = q === Infinity ? '&infin;' : q.toFixed(2);
      const convexityStr = p < 1 ? '<span class="text-rose-400 font-bold">Non-Convex (Norm Fails)</span>' : '<span class="text-emerald-400 font-bold">Convex Banach Space</span>';

      canvasOverlayStats.innerHTML = `p = ${p.toFixed(1)}, q = ${qStr} &bull; ${convexityStr}`;
    }

    // --- Quiz Logic ---
    function initQuiz() {
      const container = document.getElementById('quiz-container');
      container.innerHTML = '';

      quizQuestions.forEach((item, qIdx) => {
        const card = document.createElement('div');
        card.className = "p-4 rounded-xl border border-slate-200 bg-slate-50 space-y-3";
        card.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100">${item.unit}</span>
            <span id="quiz-status-${qIdx}" class="text-xs font-semibold text-slate-400">Unanswered</span>
          </div>
          <p class="text-xs md:text-sm font-semibold text-slate-900">${item.q}</p>
          <div class="space-y-1.5" id="opts-${qIdx}">
            ${item.options.map((opt, oIdx) => `
              <button data-q="${qIdx}" data-o="${oIdx}" class="quiz-opt-btn w-full text-left p-2.5 rounded-lg border border-slate-200 bg-white hover:bg-indigo-50 text-xs text-slate-700 transition flex items-start gap-2">
                <span class="w-4 h-4 rounded-full border border-slate-300 flex items-center justify-center text-[10px] text-slate-500 font-bold mt-0.5">${String.fromCharCode(65 + oIdx)}</span>
                <span class="flex-1">${opt}</span>
              </button>
            `).join('')}
          </div>
          <div id="quiz-exp-${qIdx}" class="hidden p-2.5 rounded-lg text-xs leading-relaxed"></div>
        `;
        container.appendChild(card);
      });

      // Bind button events
      container.querySelectorAll('.quiz-opt-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const qIdx = parseInt(btn.dataset.q);
          const oIdx = parseInt(btn.dataset.o);
          checkQuizAnswer(qIdx, oIdx);
        });
      });

      if (window.renderMathInElement) {
        renderMathInElement(container, {
          delimiters: [
            {left: '$$', right: '$$', display: true},
            {left: '$', right: '$', display: false},
            {left: '\(', right: '\)', display: false},
            {left: '\[', right: '\]', display: true}
          ],
          throwOnError: false
        });
      }
    }

    function checkQuizAnswer(qIdx, oIdx) {
      const q = quizQuestions[qIdx];
      const optBtns = document.querySelectorAll(`#opts-${qIdx} .quiz-opt-btn`);
      const statusLbl = document.getElementById(`quiz-status-${qIdx}`);
      const expDiv = document.getElementById(`quiz-exp-${qIdx}`);

      optBtns.forEach(btn => btn.disabled = true);

      if (oIdx === q.answer) {
        statusLbl.innerHTML = '<span class="text-emerald-600 font-bold">&check; Correct!</span>';
        expDiv.className = "p-2.5 rounded-lg text-xs bg-emerald-50 border border-emerald-200 text-emerald-900 block";
        expDiv.innerHTML = `<strong>Correct:</strong> ${q.explanation}`;
        optBtns[oIdx].classList.add('bg-emerald-100', 'border-emerald-400', 'text-emerald-900');
      } else {
        statusLbl.innerHTML = '<span class="text-rose-600 font-bold">&cross; Incorrect</span>';
        expDiv.className = "p-2.5 rounded-lg text-xs bg-rose-50 border border-rose-200 text-rose-900 block";
        expDiv.innerHTML = `<strong>Explanation:</strong> ${q.explanation}`;
        optBtns[oIdx].classList.add('bg-rose-100', 'border-rose-400', 'text-rose-900');
        optBtns[q.answer].classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-800');
      }

      updateQuizScore();
    }

    function updateQuizScore() {
      let correct = 0;
      let totalAnswered = 0;
      quizQuestions.forEach((q, idx) => {
        const status = document.getElementById(`quiz-status-${idx}`);
        if (status.textContent.includes('Correct')) { correct++; totalAnswered++; }
        else if (status.textContent.includes('Incorrect')) { totalAnswered++; }
      });
      document.getElementById('quiz-score').textContent = `Score: ${correct} / ${quizQuestions.length} (${totalAnswered} completed)`;
    }

    // --- Wire Event Handlers ---
    document.addEventListener('DOMContentLoaded', () => {
      // Unit pills click
      unitPills.forEach(pill => {
        pill.addEventListener('click', () => {
          selectUnit(pill.dataset.unit);
        });
      });

      // Jump to sim button
      document.getElementById('btn-jump-sim').addEventListener('click', () => {
        document.getElementById('visual-pane').scrollIntoView({ behavior: 'smooth' });
      });

      // Quiz modal controls
      const quizModal = document.getElementById('quiz-modal');
      document.getElementById('btn-quiz-view').addEventListener('click', () => {
        quizModal.classList.remove('hidden');
        initQuiz();
      });
      document.getElementById('btn-close-quiz').addEventListener('click', () => {
        quizModal.classList.add('hidden');
      });
      document.getElementById('btn-reset-quiz').addEventListener('click', () => {
        initQuiz();
        document.getElementById('quiz-score').textContent = "Answer questions to evaluate score";
      });

      // Syllabus & Lab toggles
      document.getElementById('btn-syllabus-view').addEventListener('click', () => {
        document.getElementById('teaching-pane').scrollIntoView({ behavior: 'smooth' });
      });
      document.getElementById('btn-visual-lab').addEventListener('click', () => {
        document.getElementById('visual-pane').scrollIntoView({ behavior: 'smooth' });
      });

      // Responsive Canvas resize handling
      function resizeCanvas() {
        const container = simCanvas.parentElement;
        const rect = container.getBoundingClientRect();
        if (rect.width > 0) {
          simCanvas.width = rect.width;
          simCanvas.height = Math.max(300, Math.min(360, rect.width * 0.65));
          drawSimulation();
        }
      }
      window.addEventListener('resize', resizeCanvas);

      // Initial Unit Load
      selectUnit(1);
      resizeCanvas();
    });
  </script>
</body>
</html>
