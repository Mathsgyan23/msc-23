                <button id="ctrl-u6-nonbv" class="px-2.5 py-1 text-xs rounded ${simState.u6_func === 'nonbv' ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-700'}">Non-BV Monster x cos(pi/2x)</button>
